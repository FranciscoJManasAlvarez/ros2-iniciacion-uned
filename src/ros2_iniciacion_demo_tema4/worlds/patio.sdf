<?xml version="1.0"?>
<sdf version="1.8">
  <world name="patio">
    <gravity>0 0 -9.8</gravity>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name="suelo">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry></visual>
      </link>
    </model>
    <model name="banco">
      <static>true</static>
      <pose>1 1 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.2 0.4 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.2 0.4 0.5</size></box></geometry></visual>
      </link>
    </model>
  </world>
</sdf>
