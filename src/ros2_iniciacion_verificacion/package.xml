<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ros2_iniciacion_verificacion</name>
  <version>0.1.0</version>
  <description>
    Nodos, launch files y configuración para la validación automática de los
    ejercicios de los Temas 2-5 del curso UNED "Introducción a la Robótica con
    ROS 2". El Tema 1 queda pendiente de definición.
  </description>
  <maintainer email="fma527@ual.es">Francisco José Mañas Álvarez</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>rqt_gui</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <!-- Paquetes con los que el alumno debe compilar este verificador en el mismo workspace -->
  <exec_depend>tema2_practica</exec_depend>
  <exec_depend>tema2_practica_interfaces</exec_depend>
  <exec_depend>tema3_practica</exec_depend>
  <exec_depend>tema4_practica</exec_depend>
  <exec_depend>tema5_practica</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
