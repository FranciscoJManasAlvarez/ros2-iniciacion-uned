<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ros2_iniciacion_demo_tema5</name>
  <version>0.1.0</version>
  <description>
    Demo de configuración RViz/RQT, interfaz PyQt mínima y foxglove_bridge,
    complementaria a la práctica evaluada del Tema 5.
  </description>
  <maintainer email="fma527@ual.es">Francisco José Mañas Álvarez</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>rqt_gui</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
